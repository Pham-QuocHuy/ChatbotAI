# ============================================================
# .env — Biến môi trường (KHÔNG commit file này lên Git!)
# ============================================================

# --- Gemini API ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- JWT ---
SECRET_KEY=change-this-to-a-long-random-secret-string

# --- Gmail SMTP ---
# Điền Gmail của bạn (dùng để gửi OTP)
SMTP_USER=yourgmail@gmail.com
# App Password (16 ký tự, tạo tại: Google Account → Bảo mật → Mật khẩu ứng dụng)
# Ví dụ: abcd efgh ijkl mnop → nhập không có dấu cách: abcdefghijklmnop
SMTP_PASSWORD=your_16_char_app_password
